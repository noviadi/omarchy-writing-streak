[Unit]
Description=Hourly free-writing reminder window (06:00-17:00)

# The timer is deliberately dumb: it fires every hour 06:00-17:00 and the CLI
# decides (via ~/.config/omarchy/writing-streak.json policy) which fires ping.
# Persistent=true: missed fires (machine off/asleep) run at next boot — the
# long-weekend failure mode this whole widget exists to prevent.
# If you change the hour span here, mirror it in windowStart/windowEnd of the
# config file (used to tell "inside window" fires from catch-up fires).

[Timer]
OnCalendar=*-*-* 06..17:00:00
Persistent=true
Unit=omarchy-writing-streak.service

[Install]
WantedBy=timers.target
